generator apiClient {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

generator workerClient {
  provider = "prisma-client"
  output   = "../apps/worker/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum JobType {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
}

enum TriggerType {
  MANUAL
  SCHEDULED
}

enum WorkerStatus {
  ACTIVE
  OFFLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs Job[]
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  type        JobType
  url         String
  headers     Json?
  body        Json?
  status      JobStatus @default(ACTIVE)
  cron        String?
  timeoutMs   Int       @default(30000)
  maxRetries  Int       @default(3)
  backoffMs   Int       @default(1000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions Execution[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model Execution {
  id           String          @id @default(cuid())
  jobId        String
  status       ExecutionStatus @default(QUEUED)
  triggerType  TriggerType
  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  workerId     String?
  attemptCount Int             @default(0)
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  job     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempts ExecutionAttempt[]

  @@index([jobId, createdAt])
  @@index([jobId, status])
  @@index([status, createdAt])
  @@index([workerId, status])
}

model ExecutionAttempt {
  id           String          @id @default(cuid())
  executionId  String
  attemptNumber Int
  status       ExecutionStatus
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  statusCode   Int?
  responseBody String?
  errorMessage String?
  createdAt    DateTime        @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, attemptNumber])
  @@index([executionId, createdAt])
}

model Worker {
  id           String        @id @default(cuid())
  name         String        @unique
  status       WorkerStatus  @default(ACTIVE)
  lastHeartbeat DateTime
  startedAt    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, lastHeartbeat])
}